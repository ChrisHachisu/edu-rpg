{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edu-rpg.invalid/schemas/release-identity-v1.json",
  "title": "Edu RPG reviewed native release identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidateId",
    "core",
    "qaReceipts",
    "preparationOnly"
  ],
  "properties": {
    "schema": {
      "const": "edu-rpg-release-identity/v1"
    },
    "status": {
      "enum": [
        "pending-qa",
        "sealed"
      ]
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repoRoot",
        "head",
        "terrainProfile",
        "bundleId",
        "marketingVersion",
        "buildNumber",
        "sourceInputs",
        "sourceInputsSha256",
        "nativeInputs",
        "nativeInputsSha256",
        "runtimePayloadSha256",
        "runtimeFileCount",
        "simulatorAppSha256",
        "simulatorAppInventory",
        "simulatorAppPlatform",
        "simulatorAppBundleId",
        "simulatorAppBuildNumber",
        "pbxprojPath",
        "pbxprojSha256",
        "pbxprojSourceText"
      ],
      "properties": {
        "schema": {
          "const": "edu-rpg-release-identity/v1"
        },
        "repoRoot": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "terrainProfile": {
          "enum": [
            "historical",
            "act1-forward-20261007-v1"
          ]
        },
        "bundleId": {
          "const": "app.chalkmap.questofknowledge"
        },
        "marketingVersion": {
          "const": "1.0"
        },
        "buildNumber": {
          "type": "integer",
          "minimum": 1
        },
        "sourceInputs": {
          "$ref": "#/$defs/inventory"
        },
        "sourceInputsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "nativeInputs": {
          "$ref": "#/$defs/inventory"
        },
        "nativeInputsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimePayloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeFileCount": {
          "type": "integer",
          "minimum": 1
        },
        "simulatorAppSha256": {
          "$ref": "#/$defs/sha256"
        },
        "simulatorAppInventory": {
          "$ref": "#/$defs/inventory"
        },
        "simulatorAppPlatform": {
          "const": "simulator"
        },
        "simulatorAppBundleId": {
          "const": "app.chalkmap.questofknowledge"
        },
        "simulatorAppBuildNumber": {
          "type": "integer",
          "minimum": 1
        },
        "pbxprojPath": {
          "const": "ios/App/App.xcodeproj/project.pbxproj"
        },
        "pbxprojSha256": {
          "$ref": "#/$defs/sha256"
        },
        "pbxprojSourceText": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qaReceipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sealedReceipt"
      }
    },
    "preparationOnly": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending-qa"
          }
        }
      },
      "then": {
        "properties": {
          "qaReceipts": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "sealed"
          }
        }
      },
      "then": {
        "properties": {
          "qaReceipts": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inventoryEntry"
      }
    },
    "sealedReceipt": {
      "type": "object",
      "required": [
        "receiptPath",
        "receiptSha256",
        "deviceRole"
      ],
      "properties": {
        "receiptPath": {
          "type": "string",
          "minLength": 1
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "deviceRole": {
          "enum": [
            "phone",
            "tablet"
          ]
        }
      }
    }
  }
}
