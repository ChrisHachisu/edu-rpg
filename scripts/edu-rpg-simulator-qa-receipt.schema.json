{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edu-rpg.invalid/schemas/simulator-qa-receipt-v1.json",
  "title": "Edu RPG native simulator QA receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reviewer", "reviewerIndependentOfImplementation", "testedAt", "result", "candidateId", "platform", "deviceRole", "deviceModel", "runtimeVersion", "udid", "bundleId", "buildNumber", "simulatorAppSha256", "checks", "evidence"],
  "properties": {
    "schema": {"const": "edu-rpg-simulator-qa-receipt/v1"},
    "reviewer": {"type": "string", "minLength": 2},
    "reviewerIndependentOfImplementation": {"const": true},
    "testedAt": {"type": "string", "format": "date-time"},
    "result": {"const": "pass"},
    "candidateId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platform": {"const": "iOS Simulator"},
    "deviceRole": {"enum": ["phone", "tablet"]},
    "deviceModel": {"type": "string", "minLength": 1},
    "runtimeVersion": {"type": "string", "minLength": 1},
    "udid": {"type": "string", "pattern": "^[0-9A-Fa-f-]{36}$"},
    "bundleId": {"const": "app.chalkmap.questofknowledge"},
    "buildNumber": {"type": "integer", "minimum": 1},
    "simulatorAppSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terrainContactBothHeroes", "cliffGrassRoutes", "caveDoorBridgeRoutes", "chunkStreamingAndResume", "savePreservationAndInterruption", "battleFleeBossReturn"],
      "properties": {
        "terrainContactBothHeroes": {"const": true},
        "cliffGrassRoutes": {"const": true},
        "caveDoorBridgeRoutes": {"const": true},
        "chunkStreamingAndResume": {"const": true},
        "savePreservationAndInterruption": {"const": true},
        "battleFleeBossReturn": {"const": true}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "checksCovered"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "checksCovered": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["terrainContactBothHeroes", "cliffGrassRoutes", "caveDoorBridgeRoutes", "chunkStreamingAndResume", "savePreservationAndInterruption", "battleFleeBossReturn"]}
          }
        }
      }
    }
  }
}
