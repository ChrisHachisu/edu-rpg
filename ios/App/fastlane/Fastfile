require 'json'
require 'digest'
require 'shellwords'

default_platform(:ios)

# --- edu-rpg (Quest of Knowledge) local TestFlight pipeline (Capacitor, no EAS, $0/build) ---
# Adapted from chalkmap-v2's Fastfile. Same 合同会社 Apple account (M969PWP3PU), so it reuses the
# shared ASC API key + distribution cert in the dedicated cmbuild keychain. This is a plain
# Capacitor web-wrapped game (dist/ -> ios/App/App/public); NO RN/Hermes/Expo/backend, so the
# chalkmap prod-DB guard, Hermes-flavor swap, and EAS env-pull steps are intentionally absent.

WORKSPACE     = "App.xcworkspace"
SCHEME        = "App"
APP_ID        = "app.chalkmap.questofknowledge"
TEAM_ID       = "M969PWP3PU"
ROOT          = File.expand_path("../../..", __dir__)
ASC_KEY_ID    = "52937L4S9H"
ASC_ISSUER_ID = "006a572e-afa8-464e-8f46-ce19bd161a9f"
ASC_KEY_PATH  = File.expand_path("~/Documents/claudecode/chalkmap-v2/.eas-credentials/AuthKey_52937L4S9H.p8")
OUTPUT_DIR    = File.join(ROOT, "ios", "build")
SIGNING_DIR   = "/tmp/edu-signing"
KEYCHAIN_NAME = "cmbuild.keychain"
KEYCHAIN_PATH = File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")
KEYCHAIN_PW   = "cmbuild-local-throwaway"   # protects a LOCAL build keychain only; not a real secret
APP_VERSION   = "1.0"
BUILD_FLOOR   = 5                            # known VALID floor; ASC latest still determines the next build

platform :ios do
  desc "Build locally + upload to TestFlight via the ASC API key (no EAS, $0/build)"
  lane :beta do
    requested_root = ENV["SHIP_APP_DIR"]
    UI.user_error!("Run through scripts/ship-ios.sh so the authorized checkout is explicit") if requested_root.to_s.empty?
    UI.user_error!("Checkout mismatch: requested #{requested_root}, Fastfile owns #{ROOT}") unless File.realpath(requested_root) == File.realpath(ROOT)
    reviewed_identity = ENV["EDURPG_REVIEWED_CANDIDATE_IDENTITY"]
    UI.user_error!("Set EDURPG_REVIEWED_CANDIDATE_IDENTITY to the reviewed simulator candidate identity JSON") if reviewed_identity.to_s.empty?
    UI.user_error!("Reviewed simulator candidate identity file does not exist") unless File.file?(reviewed_identity)
    reviewed_identity_sha256 = ENV["EDURPG_REVIEWED_CANDIDATE_IDENTITY_SHA256"]
    UI.user_error!("Set the externally pinned EDURPG_REVIEWED_CANDIDATE_IDENTITY_SHA256") unless reviewed_identity_sha256.to_s.match?(/\A[0-9a-f]{64}\z/)
    identity_gate = File.join(ROOT, "scripts", "verify_edu_rpg_release_identity.py")
    UI.user_error!("Missing reviewed-candidate release identity gate: #{identity_gate}") unless File.file?(identity_gate)
    terrain_profile = ENV.fetch("QOK_TERRAIN_PROFILE", "historical")
    UI.user_error!("Unknown terrain profile: #{terrain_profile}") unless ["historical", "act1-forward-20261007-v1"].include?(terrain_profile)
    terrain_evidence = ENV["EDURPG_REVIEWED_TERRAIN_EVIDENCE"]
    terrain_evidence_sha256 = ENV["EDURPG_REVIEWED_TERRAIN_EVIDENCE_SHA256"]
    if terrain_profile == "act1-forward-20261007-v1"
      UI.user_error!("Forward shipping requires the externally pinned terrain evidence envelope") if terrain_evidence.to_s.empty?
      UI.user_error!("Set the externally pinned terrain evidence SHA-256") unless terrain_evidence_sha256.to_s.match?(/\A[0-9a-f]{64}\z/)
      UI.user_error!("Terrain evidence envelope does not exist") unless File.file?(terrain_evidence)
    elsif terrain_evidence || terrain_evidence_sha256
      UI.user_error!("Terrain release evidence cannot be inherited for the historical profile")
    end
    terrain_release_args = []
    if terrain_profile == "act1-forward-20261007-v1"
      terrain_release_args = ["--terrain-evidence", terrain_evidence,
                              "--terrain-evidence-sha256", terrain_evidence_sha256]
    end
    sh(["bash", File.join(ROOT, "scripts/ship-gate.sh"), ROOT,
        "--terrain-profile", terrain_profile,
        "--release-identity", reviewed_identity,
        "--identity-sha256", reviewed_identity_sha256,
        *terrain_release_args].map { |arg| Shellwords.escape(arg) }.join(" "))
    sh([
      "python3", identity_gate, "candidate", "--root", ROOT,
      "--identity", reviewed_identity, "--identity-sha256", reviewed_identity_sha256,
      "--terrain-profile", terrain_profile,
      *terrain_release_args
    ].map { |arg| Shellwords.escape(arg) }.join(" "))

    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      in_house: false
    )

    # 1. Dedicated build keychain (reused from chalkmap; same account/cert). Persisted across runs.
    if File.exist?(KEYCHAIN_PATH)
      unlock_keychain(path: KEYCHAIN_NAME, password: KEYCHAIN_PW, add_to_search_list: true, set_default: false)
    else
      create_keychain(
        name: KEYCHAIN_NAME,
        password: KEYCHAIN_PW,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false,
        add_to_search_list: true
      )
    end

    # 2. Distribution cert into the dedicated keychain (reused if already present).
    cert(
      api_key: api_key,
      keychain_path: KEYCHAIN_PATH,
      keychain_password: KEYCHAIN_PW,
      output_path: SIGNING_DIR
    )
    cert_sha1 = sh("security find-identity -v -p codesigning #{KEYCHAIN_PATH} | grep 'Apple Distribution' | head -1 | awk '{print $2}'").strip
    UI.important("Signing identity (dedicated keychain): #{cert_sha1}")

    # Make codesign use OUR keychain's authorized copy (promptless).
    login_kc = File.expand_path("~/Library/Keychains/login.keychain-db")
    sh("security list-keychains -d user -s '#{KEYCHAIN_PATH}' '#{login_kc}'")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{KEYCHAIN_PW}' '#{KEYCHAIN_PATH}' >/dev/null 2>&1; true")

    # 3. Fresh App Store provisioning profile for this app id (via the API key).
    sigh(
      api_key: api_key,
      app_identifier: APP_ID,
      output_path: SIGNING_DIR,
      force: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    UI.important("Using provisioning profile: #{profile_name}")

    # 4. Next build number = one above the highest already on TestFlight (floor 5).
    latest = latest_testflight_build_number(
      app_identifier: APP_ID,
      api_key: api_key,
      version: APP_VERSION,
      initial_build_number: BUILD_FLOOR
    )
    build_num = [latest, BUILD_FLOOR].max + 1
    UI.important("Version #{APP_VERSION}: TestFlight latest = #{latest} -> building #{build_num}")
    sh([
      "python3", identity_gate, "candidate", "--root", ROOT,
      "--identity", reviewed_identity, "--identity-sha256", reviewed_identity_sha256,
      "--terrain-profile", terrain_profile,
      *terrain_release_args,
      "--expected-build", build_num.to_s
    ].map { |arg| Shellwords.escape(arg) }.join(" "))

    # 5. Manual signing onto the APP TARGET ONLY (Release). This mutates project.pbxproj;
    # the IPA verifier checks the full native input set and permits only signing-key changes.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: TEAM_ID,
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: cert_sha1,
      profile_name: profile_name
    )

    # 6. Archive + export (manual signing already set on the app target).
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "questofknowledge.ipa",
      clean: true,
      xcargs: "MARKETING_VERSION=#{APP_VERSION} CURRENT_PROJECT_VERSION=#{build_num} IPHONEOS_DEPLOYMENT_TARGET=16.4",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { APP_ID => profile_name }
      }
    )

    ipa_path = File.join(OUTPUT_DIR, "questofknowledge.ipa")
    sh([
      "python3", identity_gate, "ipa", "--root", ROOT,
      "--identity", reviewed_identity, "--identity-sha256", reviewed_identity_sha256,
      "--terrain-profile", terrain_profile,
      *terrain_release_args,
      "--expected-team", TEAM_ID, "--expected-signing-identity", cert_sha1,
      "--expected-profile", profile_name,
      "--ipa", ipa_path
    ].map { |arg| Shellwords.escape(arg) }.join(" "))
    verified_ipa_sha256 = Digest::SHA256.file(ipa_path).hexdigest

    latest_after_archive = latest_testflight_build_number(
      app_identifier: APP_ID,
      api_key: api_key,
      version: APP_VERSION,
      initial_build_number: BUILD_FLOOR
    )
    UI.user_error!("TestFlight latest build changed during archive (#{latest} -> #{latest_after_archive}); refusing upload") unless latest_after_archive == latest

    sh([
      "python3", identity_gate, "ipa", "--root", ROOT,
      "--identity", reviewed_identity, "--identity-sha256", reviewed_identity_sha256,
      "--terrain-profile", terrain_profile,
      *terrain_release_args,
      "--expected-team", TEAM_ID, "--expected-signing-identity", cert_sha1,
      "--expected-profile", profile_name,
      "--ipa", ipa_path
    ].map { |arg| Shellwords.escape(arg) }.join(" "))
    UI.user_error!("Exported IPA changed after identity verification; refusing upload") unless Digest::SHA256.file(ipa_path).hexdigest == verified_ipa_sha256

    FileUtils.mkdir_p(OUTPUT_DIR)
    pending_build_file = File.join(OUTPUT_DIR, "pending-testflight-build.txt")
    File.write(pending_build_file, build_num.to_s)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
    UI.user_error!("Exported IPA bytes changed during upload; refusing delivery report") unless Digest::SHA256.file(ipa_path).hexdigest == verified_ipa_sha256

    File.write(File.join(OUTPUT_DIR, "last-testflight-build.txt"), build_num.to_s)
    File.delete(pending_build_file) if File.exist?(pending_build_file)

    UI.success("Uploaded #{APP_VERSION} (#{build_num}) to TestFlight - processing ~5-15 min on Apple's side.")
  end

  # Plain TestFlight path (build 85, 2026-10-25). Same signing/build/upload as :beta, without the
  # sealed release-identity and forward-terrain evidence envelopes, which could not be produced
  # for this build. Replaces them with direct payload checks: frozen bundle, overlay twins, pins.
  desc "Build + upload to TestFlight without the sealed identity/evidence envelope (owner-authorized)"
  lane :beta_unsealed do
    frozen = Digest::SHA256.file(File.join(ROOT, "dist/assets/index-BhoGQRaA.js")).hexdigest
    UI.user_error!("Frozen bundle changed: #{frozen}") unless frozen == "ab4fc9ad1204f23b4ea55dbae2d72bdf193a52e643271bcfe8642e2210556456"
    %w[dq-tiles.js hero-override.js ui-overhaul.js ui-overhaul.css].each do |f|
      sh("cmp #{Shellwords.escape(File.join(ROOT, 'public', f))} #{Shellwords.escape(File.join(ROOT, 'dist', f))}")
      sh("cmp #{Shellwords.escape(File.join(ROOT, 'dist', f))} #{Shellwords.escape(File.join(ROOT, 'ios/App/App/public', f))}")
    end
    sh("cmp #{Shellwords.escape(File.join(ROOT, 'dist/index.html'))} #{Shellwords.escape(File.join(ROOT, 'ios/App/App/public/index.html'))}")
    sh("cd #{Shellwords.escape(ROOT)} && python3 scripts/regenerate_pins.py --check")

    api_key = app_store_connect_api_key(key_id: ASC_KEY_ID, issuer_id: ASC_ISSUER_ID, key_filepath: ASC_KEY_PATH, in_house: false)
    if File.exist?(KEYCHAIN_PATH)
      unlock_keychain(path: KEYCHAIN_NAME, password: KEYCHAIN_PW, add_to_search_list: true, set_default: false)
    else
      create_keychain(name: KEYCHAIN_NAME, password: KEYCHAIN_PW, default_keychain: false, unlock: true,
                      timeout: 3600, lock_when_sleeps: false, add_to_search_list: true)
    end
    cert(api_key: api_key, keychain_path: KEYCHAIN_PATH, keychain_password: KEYCHAIN_PW, output_path: SIGNING_DIR)
    cert_sha1 = sh("security find-identity -v -p codesigning #{KEYCHAIN_PATH} | grep 'Apple Distribution' | head -1 | awk '{print $2}'").strip
    login_kc = File.expand_path("~/Library/Keychains/login.keychain-db")
    sh("security list-keychains -d user -s '#{KEYCHAIN_PATH}' '#{login_kc}'")
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '#{KEYCHAIN_PW}' '#{KEYCHAIN_PATH}' >/dev/null 2>&1; true")
    sigh(api_key: api_key, app_identifier: APP_ID, output_path: SIGNING_DIR, force: true)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    latest = latest_testflight_build_number(app_identifier: APP_ID, api_key: api_key, version: APP_VERSION, initial_build_number: BUILD_FLOOR)
    build_num = [latest, BUILD_FLOOR].max + 1
    UI.important("Version #{APP_VERSION}: TestFlight latest = #{latest} -> building #{build_num}")

    pbxproj = File.join(__dir__, "..", "App.xcodeproj", "project.pbxproj")
    pbx_backup = File.read(pbxproj)
    begin
      update_code_signing_settings(use_automatic_signing: false, path: "App.xcodeproj", team_id: TEAM_ID, targets: ["App"],
                                   build_configurations: ["Release"], code_sign_identity: cert_sha1, profile_name: profile_name)
      build_app(workspace: WORKSPACE, scheme: SCHEME, configuration: "Release", export_method: "app-store",
                output_directory: OUTPUT_DIR, output_name: "questofknowledge.ipa", clean: true,
                xcargs: "MARKETING_VERSION=#{APP_VERSION} CURRENT_PROJECT_VERSION=#{build_num} IPHONEOS_DEPLOYMENT_TARGET=16.4",
                export_options: { signingStyle: "manual", teamID: TEAM_ID, provisioningProfiles: { APP_ID => profile_name } })
    ensure
      File.write(pbxproj, pbx_backup)
    end

    upload_to_testflight(api_key: api_key, app_identifier: APP_ID, skip_submission: true, skip_waiting_for_build_processing: true)
    File.write(File.join(OUTPUT_DIR, "last-testflight-build.txt"), build_num.to_s)
    UI.success("Uploaded #{APP_VERSION} (#{build_num}) to TestFlight")
  end
end
